# Organa — Environment Variables

# Database
DATABASE_URL="postgresql://organa:organa_dev@localhost:5432/organa?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRATION="24h"

# Konnect (primary payment provider)
KONNECT_API_KEY=""
KONNECT_API_SECRET=""
KONNECT_SANDBOX=true

# WhatsApp Business API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Resend / Postmark (email fallback)
RESEND_API_KEY=""

# Twilio (SMS fallback)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Cloudflare R2 / S3 (file storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="organa-uploads"

# App
NEXT_PUBLIC_API_URL="http://localhost:4000"
NODE_ENV="development"
